{
  "name": "dydan",
  "private": true,
  "version": "202609-13",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "start": "vite --host",
    "dev": "vite",
    "format:figma": "oxfmt",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:ui-architecture": "node scripts/check-global-ui.mjs",
    "test": "node --test && npm run test:ui",
    "test:ui": "vitest run --pool=forks src/utils/tokenStorage.audit.spec.js src/utils/tokenStorage.native.audit.spec.js src/utils/passwordResetCredential.audit.spec.js src/utils/passwordResetTransport.audit.spec.js src/utils/accountOperations.audit.spec.js src/hooks/settingsPreferenceModel.spec.ts src/components/CategorySettings.test.tsx src/components/ColorPicker.test.tsx src/components/colorPickerGeometry.spec.tsx src/components/settingsCategoryPlacement.spec.ts src/ui/globalUiContracts.spec.ts",
    "test:coverage": "npm run test:ui -- --coverage",
    "test:smoke": "playwright test --project=chromium",
    "test:smoke:sovereign": "CI=1 VITE_APP_BRAND=sovereign playwright test --project=sovereign",
    "test:smoke:ui": "playwright test --ui",
    "test:smoke:cross-browser": "playwright test --project=chromium-critical --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "build:smoke": "vite build --mode smoke",
    "reference:build": "vite build --config design-reference/vite.config.mjs",
    "reference:dev": "vite --config design-reference/vite.config.mjs",
    "reference:test": "node --test design-reference/src/*.test.js",
    "build-cf": "npm ci && npm run build",
    "lint": "eslint && prettier -c .",
    "lint:ci": "eslint && prettier -c .",
    "lint:fix": "eslint --fix && prettier -w .",
    "preview": "vite preview",
    "setup-m1": "rm -rf node_modules package-lock.json && npm install && npm install --force @rollup/rollup-darwin-arm64 @swc/core-darwin-arm64",
    "setup-apple-silicon": "npm install --no-optional && npm install --force @rollup/rollup-darwin-arm64 @swc/core-darwin-arm64",
    "ionic:build": "npm run build",
    "ionic:serve": "npm run start",
    "android": "npm run build && npx cap sync android",
    "android:dev": "npx cap run android --live-reload",
    "cap": "npm run build && npx cap sync",
    "bump": "node bump-version.js patch",
    "bump:minor": "node bump-version.js minor",
    "bump:major": "node bump-version.js major",
    "bump:patch": "node bump-version.js patch",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-llm": "^1.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-document-scanner": "^8.4.3",
    "@capgo/capacitor-nfc": "^8.2.5",
    "@capgo/capacitor-social-login": "^8.3.38",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/ubuntu-sans": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jcesarmobile/capacitor-ocr": "^0.3.0",
    "@mui/icons-material": "^5.16.13",
    "@mui/joy": "^5.0.0-beta.20",
    "@mui/material": "^5.15.2",
    "@revenuecat/purchases-capacitor": "^12.0.0",
    "@revenuecat/purchases-capacitor-ui": "^12.0.0",
    "@rollup/rollup-linux-x64-gnu": "^4.62.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.1",
    "@swc/core-linux-x64-gnu": "^1.16.1",
    "@tanstack/react-query": "^5.101.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "capacitor-plugin-safe-area": "^5.0.0",
    "dompurify": "^3.4.14",
    "dotenv": "^16.4.5",
    "event-source-polyfill": "^1.0.31",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "js-cookie": "^3.0.8",
    "moment": "^2.30.1",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-calendar": "^5.1.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "recharts": "^2.15.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "capacitor-set-version": "^2.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.2.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "tesseract.js@7.0.0": true
  }
}
